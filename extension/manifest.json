{
  "manifest_version": 3,
  "name": "JobPilot Copilot - AI Auto-Apply",
  "version": "1.2.1",
  "description": "1-Click auto-fill and auto-apply companion for JobPilot. Bypasses Cloudflare on Indeed, Wellfound, LinkedIn, and external career portals.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "JobPilot Copilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://*.indeed.com/*",
    "https://*.wellfound.com/*",
    "https://*.linkedin.com/*",
    "https://*.cutshort.io/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": ["scripts/content.js"],
      "css": ["scripts/content.css"],
      "all_frames": true,
      "run_at": "document_end"
    }
  ]
}
